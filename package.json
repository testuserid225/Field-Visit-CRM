{
  "name": "field_visit_crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "start:gateway": "node services/gateway/server.js",
    "start:auth": "node services/auth-service/server.js",
    "start:visit": "node services/visit-service/server.js",
    "start:sales": "node services/sales-service/server.js",
    "start:master": "node services/master-service/server.js",
    "services:all": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,AUTH,VISIT,SALES,MASTER\" -c \"magenta,cyan,green,yellow,blue\" \"node services/gateway/server.js\" \"node services/auth-service/server.js\" \"node services/visit-service/server.js\" \"node services/sales-service/server.js\" \"node services/master-service/server.js\"",
    "dev:microservices": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,AUTH,VISIT,SALES,MASTER\" -c \"magenta,cyan,green,yellow,blue\" \"node services/gateway/server.js\" \"node services/auth-service/server.js\" \"node services/visit-service/server.js\" \"node services/sales-service/server.js\" \"node services/master-service/server.js\"",
    "dev:full": "concurrently -k -n \"FRONTEND,MICROSERVICES\" -c \"blue,magenta\" \"npm run dev\" \"npm run services:all\"",
    "migrate:atlas": "node backend/scripts/migrateToAtlas.js"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-http-proxy": "^2.1.2",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.49.0",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.15",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "vite": "^5.4.10",
    "ws": "^8.22.0"
  }
}
